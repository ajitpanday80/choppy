# Zerodha API Credentials
# Get these from https://kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=your_access_token_here

# Trading Mode
# Options: PAPER or REAL
TRADING_MODE=PAPER

# Risk Management
MAX_DAILY_LOSS=5000
MAX_POSITIONS=2
POSITION_SIZE=1

# Strategy Parameters
AVTI_THRESHOLD=65
TARGET_PROFIT_PERCENT=30
STOP_LOSS_PERCENT=20
TRAILING_STOP_PERCENT=15

# Trading Hours (IST - 24hr format)
TRADING_START_HOUR=9
TRADING_START_MINUTE=20
TRADING_END_HOUR=15
TRADING_END_MINUTE=20

# Logging
LOG_LEVEL=INFO
